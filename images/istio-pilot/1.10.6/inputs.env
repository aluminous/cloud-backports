# Pinned inputs of istio-pilot 1.10.6 for linux/arm64. Every value is a pin: change one and
# the outputs below change. Shell-sourceable (scripts/build-istio-pilot.sh, the workflow).
#
# The same pins as Mockyard's legacy profile (src/mockyard/profiles/legacy.yaml,
# istio.native_pilot), where this build was first made reproducible.

ISTIO_VERSION=1.10.6
# The upstream release tag's commit (embedded in the binary by the release ldflags).
ISTIO_REVISION=fd053c6165d21105d66dac6e3d0649db2dde5b86
# GitHub's tag tarball of the release.
SOURCE_URL=https://github.com/istio/istio/archive/refs/tags/1.10.6.tar.gz
SOURCE_SHA256=c737648a6dc6b4bb3a5ac1dfc202469ced73e54c83cc591db917120c5590aae4

# The Go toolchain: go.mod declares `go 1.16`; upstream's official 1.10.6 binaries were built
# with go1.16.9 (read from docker.io/istio/pilot:1.10.6). Pinned by its index digest.
GO_BUILDER=docker.io/library/golang:1.16.9@sha256:c8b7bf9166093208456120876e51e9cb387b0523bddb9d8c0b33ff621347e26f
GO_VERSION=go1.16.9
GOPROXY_DEFAULT=https://proxy.golang.org

# The runtime base (CA certificates, /tmp, passwd; no shell). Upstream used
# gcr.io/istio-release/base (Ubuntu, amd64 only).
BASE_IMAGE=gcr.io/distroless/static-debian12:nonroot@sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab

# Expected outputs.
# Deterministic tar of the Go module download cache (scripts/module_tar.py; 1892 files).
MODULES_SHA256=cc8af5e960238679557d57af2e2bf0b652d62fee6603ad8247a265a90389ffff
# The reproducible pilot-discovery binary for linux/arm64.
BINARY_SHA256_ARM64=b851b0b5af62ea9b57f2ef51b5c7ee31e624d6e4c1f06a3892c5acb778973c44

# The amd64 half of the multi-arch tag: upstream's official image, carried over by digest
# (a single linux/amd64 manifest; never rebuilt).
UPSTREAM_IMAGE=docker.io/istio/pilot:1.10.6
UPSTREAM_AMD64_DIGEST=sha256:689e4fcd118e281ad793c39326562bef63d5a2301dbe0281625a6e64022e19eb
