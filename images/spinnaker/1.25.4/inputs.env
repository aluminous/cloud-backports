# Pinned inputs of the Spinnaker 1.25.4 service image archive. Every value is a pin.
# Shell-sourceable; read by scripts/push-spinnaker.py and scripts/verify-spinnaker.py.
#
# The images are the amd64 service images of Spinnaker release 1.25.4 (the versions in the
# release's bill of materials, vendored by the old test harness as vendor/spinnaker/1.25.4/
# bom.yaml), as saved from us-docker.pkg.dev/spinnaker-community/docker in the old test
# harness's bundle cache. Nothing is rebuilt: the image config (image ID) and every layer's
# diff_id are those of the archives. The pushed manifest is made from them reproducibly by
# scripts/push-spinnaker.py, so MANIFEST_DIGEST is what any machine produces.

# Per image: VERSION is the tag, ARCHIVE and ARCHIVE_SHA256 name the source file, CONFIG_DIGEST is
# the image ID (digest of the config blob, as in the archive), LAYERS the number of layers and of
# rootfs diff_ids, MANIFEST_DIGEST the manifest scripts/push-spinnaker.py produces.

SPINNAKER_RELEASE=1.25.4
SOURCE_REPOSITORY=https://github.com/aluminous/cloud-backports
# Order of publication.
SERVICES="clouddriver front50 gate orca rosco"

# clouddriver
CLOUDDRIVER_VERSION=7.3.3-20210322155326
CLOUDDRIVER_ORIGINAL_REFERENCE=us-docker.pkg.dev/spinnaker-community/docker/clouddriver:7.3.3-20210322155326
CLOUDDRIVER_ARCHIVE=us-docker.pkg.dev-spinnaker-community-docker-clouddriver-7.3.3-20210322155326--amd64.tar
CLOUDDRIVER_ARCHIVE_SHA256=39914318659b483fc30e53c51bf8b6865ec051ac4ab01f0bfe418ebff101f0ea
CLOUDDRIVER_CONFIG_DIGEST=sha256:48a25fb6fb34f971e0c8b4704f5c511aa4f1d20bacdbe05d345b9568d03bc3b8
CLOUDDRIVER_LAYERS=14
CLOUDDRIVER_MANIFEST_DIGEST=sha256:33f0c306ce74ab06c1e61b2b6d37d494e53d737c7597ddc66adf8a6b28435bd5
CLOUDDRIVER_ORIGIN="archived from us-docker.pkg.dev/spinnaker-community/docker/clouddriver:7.3.3-20210322155326; upstream tag no longer served (checked 2026-11-14)"

